Options -Indexes
DirectoryIndex index.php

# Carpetas internas: no deben ser accesibles desde el navegador
RewriteEngine On
RewriteRule ^(src|templates|docs)(/|$) - [F,L]

# /la-matanza.php -> /la-matanza (301, una sola URL para la landing)
RewriteCond %{THE_REQUEST} \s(/(?:[^\s?]*/)?)la-matanza\.php[\s?]
RewriteRule ^la-matanza\.php$ %1la-matanza [R=301,L]

# Página local: /la-matanza -> la-matanza.php
RewriteRule ^la-matanza/?$ la-matanza.php [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
